# Non-secret local pilot configuration. The file must remain inside the approved private root.
ACADEMIC_FEEDBACK_PRIVATE_ROOT=.local/academic-feedback
ACADEMIC_FEEDBACK_PATH=.local/academic-feedback/feedback.jsonl

# Default evidence remains the approved local Registry. Never commit credentials.
ACADEMIC_EVIDENCE_BACKEND=registry
# ACADEMIC_EVIDENCE_BACKEND=neo4j
# NEO4J_URI=bolt://127.0.0.1:7687
# NEO4J_DATABASE=academic-pilot
# Set NEO4J_USER and NEO4J_PASSWORD privately in the process environment.
ACADEMIC_NEO4J_TIMEOUT_SECONDS=3

# Optional inference remains disabled until DSW preflight succeeds.
ACADEMIC_LLM_PROVIDER=disabled
# After an approved local SSH tunnel: provider=ollama, numeric loopback URL,
# verified already-loaded model ID. Do not reuse Naru gateway credentials.
ACADEMIC_LLM_MIN_INTERVAL_SECONDS=5
ACADEMIC_LLM_FAILURE_COOLDOWN_SECONDS=60

# Optional private source map: approved source_id -> original PDF absolute path.
# ACADEMIC_SOURCE_MAP=<private-project-local-json-file>
