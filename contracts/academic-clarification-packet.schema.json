{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jeongiryang/kg-ontology-decision-framework-reboot/contracts/academic-clarification-packet.schema.json",
  "title": "AcademicClarificationPacket",
  "description": "Evidence-backed clarification batches, session-scoped authority, exact user responses, preserved conflicts, and audit events for human academic review.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "clarification_id", "review_id", "state", "coverage_mode", "scope", "input_snapshots", "session", "batches", "suppressed", "conflicts", "responses", "audit_events"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "clarification_id": {"$ref": "#/$defs/id"},
    "review_id": {"$ref": "#/$defs/id"},
    "state": {"enum": ["draft", "ready", "awaiting_user", "partially_answered", "answered", "applied", "closed"]},
    "coverage_mode": {"enum": ["full_review", "partial"]},
    "scope": {"$ref": "#/$defs/scope"},
    "input_snapshots": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/snapshot"}},
    "session": {"$ref": "#/$defs/session"},
    "batches": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/batch"}},
    "suppressed": {"type": "array", "items": {"$ref": "#/$defs/suppressed"}},
    "conflicts": {"type": "array", "items": {"$ref": "#/$defs/conflict"}},
    "responses": {"type": "array", "items": {"$ref": "#/$defs/response"}},
    "audit_events": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/auditEvent"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["curriculum_year", "admission_year", "department"],
      "properties": {
        "curriculum_year": {"type": "integer", "minimum": 1900, "maximum": 2200},
        "admission_year": {"type": "integer", "minimum": 1900, "maximum": 2200},
        "department": {"type": "string", "minLength": 1}
      }
    },
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "sha256"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "status", "authorization_prompt", "choices"],
      "properties": {
        "kind": {"const": "department_confirmation"},
        "status": {"enum": ["not_requested", "granted", "declined", "expired", "revoked"]},
        "authorization_prompt": {"type": "string", "minLength": 1},
        "choices": {"type": "array", "const": ["grant", "decline"]}
      }
    },
    "session": {
      "type": "object", "additionalProperties": false,
      "required": ["session_id", "run_id", "thread_binding", "state", "started_at", "authority"],
      "properties": {
        "session_id": {"$ref": "#/$defs/id"},
        "run_id": {"$ref": "#/$defs/id"},
        "thread_binding": {"const": "current_task"},
        "state": {"enum": ["awaiting_authority", "active", "review_only", "closed"]},
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"},
        "end_reason": {"enum": ["completed", "user_closed", "task_interrupted", "run_replaced", "authority_revoked"]},
        "authority": {"$ref": "#/$defs/authority"}
      },
      "allOf": [
        {"if": {"properties": {"state": {"const": "awaiting_authority"}}, "required": ["state"]}, "then": {"properties": {"authority": {"properties": {"status": {"const": "not_requested"}}}}, "not": {"anyOf": [{"required": ["ended_at"]}, {"required": ["end_reason"]}]}}},
        {"if": {"properties": {"state": {"const": "active"}}, "required": ["state"]}, "then": {"properties": {"authority": {"properties": {"status": {"const": "granted"}}}}, "not": {"anyOf": [{"required": ["ended_at"]}, {"required": ["end_reason"]}]}}},
        {"if": {"properties": {"state": {"const": "review_only"}}, "required": ["state"]}, "then": {"properties": {"authority": {"properties": {"status": {"const": "declined"}}}}}},
        {"if": {"properties": {"state": {"const": "closed"}}, "required": ["state"]}, "then": {"required": ["ended_at", "end_reason"], "properties": {"authority": {"properties": {"status": {"enum": ["declined", "expired", "revoked"]}}}}}}
      ]
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["subject_id", "source_id", "authority", "locator", "claim"],
      "properties": {
        "subject_id": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "authority": {"enum": ["university_statute", "curriculum", "department_guidance", "validation_aid"]},
        "locator": {"type": "string", "minLength": 1},
        "claim": {"type": "string", "minLength": 1}
      }
    },
    "choice": {
      "type": "object", "additionalProperties": false,
      "required": ["choice_id", "label", "disposition", "impact"],
      "properties": {
        "choice_id": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["approve", "needs_revision", "pending", "provide_evidence"]},
        "impact": {"type": "string", "minLength": 1},
        "comment_required": {"type": "boolean"}
      }
    },
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["question_id", "subject_ids", "purpose", "ambiguity_kind", "required_authority", "evidence", "prompt", "impact", "choices", "recommended_choice_id", "blocking_subject_ids", "status"],
      "properties": {
        "question_id": {"$ref": "#/$defs/id"},
        "subject_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "purpose": {"enum": ["review_confirmation", "ambiguity_resolution", "evidence_request", "conflict_triage"]},
        "ambiguity_kind": {"enum": ["source_identity_and_scope", "relationship", "table_structure", "applicability", "exception_scope", "missing_department_practice", "source_conflict", "unsupported_schema_concept"]},
        "required_authority": {"enum": ["project_review", "department_confirmation"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "prompt": {"type": "string", "minLength": 1},
        "impact": {"type": "string", "minLength": 1},
        "choices": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"$ref": "#/$defs/choice"}},
        "recommended_choice_id": {"$ref": "#/$defs/id"},
        "blocking_subject_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "status": {"enum": ["queued", "presented", "answered", "accepted", "needs_revision", "deferred", "conflict_preserved"]}
      },
      "allOf": [
        {
          "if": {"properties": {"purpose": {"const": "conflict_triage"}}, "required": ["purpose"]},
          "then": {
            "properties": {
              "choices": {"items": {"properties": {"disposition": {"not": {"const": "approve"}}}}},
              "status": {"not": {"const": "accepted"}}
            }
          }
        }
      ]
    },
    "batch": {
      "type": "object", "additionalProperties": false,
      "required": ["batch_id", "ordinal", "topic", "status", "questions"],
      "properties": {
        "batch_id": {"$ref": "#/$defs/id"},
        "ordinal": {"type": "integer", "minimum": 1},
        "topic": {"type": "string", "minLength": 1},
        "status": {"enum": ["queued", "presented", "partially_answered", "answered", "applied", "closed"]},
        "questions": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/question"}}
      }
    },
    "suppressed": {
      "type": "object", "additionalProperties": false,
      "required": ["subject_ids", "reason", "evidence_locators"],
      "properties": {
        "subject_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "reason": {"enum": ["resolved_by_higher_authority", "already_approved", "duplicate_grouped", "out_of_scope"]},
        "evidence_locators": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "conflict": {
      "type": "object", "additionalProperties": false,
      "required": ["conflict_id", "subject_ids", "higher_source_id", "lower_claim_source", "higher_locator", "lower_locator", "higher_claim", "lower_claim", "status", "resolution_required"],
      "properties": {
        "conflict_id": {"$ref": "#/$defs/id"},
        "subject_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "higher_source_id": {"type": "string", "minLength": 1},
        "lower_claim_source": {"type": "string", "minLength": 1},
        "higher_locator": {"type": "string", "minLength": 1},
        "lower_locator": {"type": "string", "minLength": 1},
        "higher_claim": {"type": "string", "minLength": 1},
        "lower_claim": {"type": "string", "minLength": 1},
        "status": {"const": "preserved"},
        "resolution_required": {"const": "official_higher_or_equal_authority_source"}
      }
    },
    "response": {
      "type": "object", "additionalProperties": false,
      "required": ["response_id", "question_id", "session_id", "answer_mode", "exact_text", "answered_by", "answered_at", "authority_used", "normalization_status"],
      "properties": {
        "response_id": {"$ref": "#/$defs/id"},
        "question_id": {"$ref": "#/$defs/id"},
        "session_id": {"$ref": "#/$defs/id"},
        "answer_mode": {"enum": ["choice", "free_text"]},
        "selected_choice_id": {"$ref": "#/$defs/id"},
        "exact_text": {"type": "string", "minLength": 1},
        "answered_by": {"$ref": "#/$defs/id"},
        "answered_at": {"type": "string", "format": "date-time"},
        "authority_used": {"enum": ["project_review", "department_confirmation"]},
        "authorization_event_id": {"$ref": "#/$defs/id"},
        "conflict_id": {"$ref": "#/$defs/id"},
        "comment": {"type": "string", "minLength": 1},
        "normalization_status": {"enum": ["unprocessed", "accepted", "needs_clarification", "conflict_preserved"]}
      },
      "allOf": [
        {"if": {"properties": {"answer_mode": {"const": "choice"}}, "required": ["answer_mode"]}, "then": {"required": ["selected_choice_id"]}},
        {"if": {"properties": {"authority_used": {"const": "department_confirmation"}}, "required": ["authority_used"]}, "then": {"required": ["authorization_event_id"]}},
        {"if": {"properties": {"normalization_status": {"const": "conflict_preserved"}}, "required": ["normalization_status"]}, "then": {"required": ["conflict_id"]}}
      ]
    },
    "auditEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "event", "at", "actor", "details"],
      "properties": {
        "event_id": {"$ref": "#/$defs/id"},
        "event": {"enum": ["created", "authority_granted", "authority_declined", "question_presented", "answer_recorded", "authority_expired", "authority_revoked", "closed"]},
        "at": {"type": "string", "format": "date-time"},
        "actor": {"enum": ["main", "project_owner", "academic_rule_modeler"]},
        "question_id": {"$ref": "#/$defs/id"},
        "response_id": {"$ref": "#/$defs/id"},
        "conflict_id": {"$ref": "#/$defs/id"},
        "details": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"event": {"const": "question_presented"}}, "required": ["event"]}, "then": {"required": ["question_id"]}},
        {"if": {"properties": {"event": {"const": "answer_recorded"}}, "required": ["event"]}, "then": {"required": ["question_id", "response_id"]}}
      ]
    }
  }
}
