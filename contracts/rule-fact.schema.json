{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jeongiryang/kg-ontology-decision-framework-reboot/contracts/rule-fact.schema.json",
  "title": "RuleFact",
  "description": "A versioned academic rule modeled from reviewed evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rule_id",
    "applicability",
    "decision",
    "evidence",
    "approval_status"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "rule_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "label": { "type": "string", "minLength": 1 },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["academic_years", "departments", "effective_from"],
      "properties": {
        "academic_years": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1900, "maximum": 2200 }
        },
        "departments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "effective_from": { "type": "string", "format": "date" },
        "effective_to": { "type": ["string", "null"], "format": "date" },
        "conditions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement"],
      "properties": {
        "statement": { "type": "string", "minLength": 1 },
        "outcome": {},
        "operator": { "type": "string", "enum": ["all", "any", "threshold", "direct"] }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidenceReference" }
    },
    "approval_status": {
      "type": "string",
      "enum": ["pending", "approved", "rejected", "needs_review"]
    },
    "review_notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "locator"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 },
        "excerpt": { "type": "string" }
      }
    }
  }
}
