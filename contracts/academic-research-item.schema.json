{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jeongiryang/kg-ontology-decision-framework-reboot/contracts/academic-research-item.schema.json",
  "title": "AcademicResearchItem",
  "description": "Unverified academic-practice recollections isolated from answer evidence until an official source is audited.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "research_id", "scope", "origin", "status", "eligible_for_academic_answer", "linked_rule_ids", "claims", "required_evidence", "review_session_id", "created_at", "github_issue_url"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "research_id": {"$ref": "#/$defs/id"},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["curriculum_year", "admission_year", "department"],
      "properties": {
        "curriculum_year": {"const": 2026},
        "admission_year": {"const": 2026},
        "department": {"const": "컴퓨터공학과"}
      }
    },
    "origin": {"const": "unverified_user_recollection"},
    "status": {"const": "awaiting_official_source"},
    "eligible_for_academic_answer": {"const": false},
    "linked_rule_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "claims": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["claim_id", "statement", "verification_question", "status", "eligible_for_academic_answer", "answer_status_until_verified"],
        "properties": {
          "claim_id": {"$ref": "#/$defs/id"},
          "statement": {"type": "string", "minLength": 1},
          "verification_question": {"type": "string", "minLength": 1},
          "status": {"const": "unverified"},
          "eligible_for_academic_answer": {"const": false},
          "answer_status_until_verified": {"const": "insufficient_evidence"}
        }
      }
    },
    "required_evidence": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["official_department_guidance", "course_operation_plan", "approved_internal_regulation"]}
    },
    "review_session_id": {"$ref": "#/$defs/id"},
    "created_at": {"type": "string", "format": "date-time"},
    "github_issue_url": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/jeongiryang/kg-ontology-decision-framework-reboot/issues/[1-9][0-9]*$"},
    "notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"}
  }
}
