{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jeongiryang/kg-ontology-decision-framework-reboot/contracts/academic-chat-response.schema.json",
  "title": "AcademicChatResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "status", "answer", "intent_ids", "calculations", "evidence_packet", "llm_status"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "packet_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{2,127}$"},
    "status": {"enum": ["supported", "insufficient_evidence", "conflict", "out_of_scope"]},
    "answer": {"type": "string", "minLength": 1},
    "intent_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "calculations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["metric", "required", "earned", "gap"], "properties": {"metric": {"type": "string"}, "required": {"type": "integer", "minimum": 0, "maximum": 500}, "earned": {"type": "integer", "minimum": 0, "maximum": 500}, "gap": {"type": "integer", "minimum": 0, "maximum": 500}}}},
    "evidence_packet": {"$ref": "evidence-packet.schema.json"},
    "llm_status": {"enum": ["disabled", "skipped", "suggested", "unavailable", "rejected"]},
    "suggested_question": {"type": ["string", "null"], "minLength": 1},
    "context_used": {"type": "boolean"},
    "conversational_answer": {"type": ["string", "null"], "minLength": 1, "maxLength": 8000},
    "context_question": {"type": ["string", "null"], "minLength": 1, "maxLength": 500},
    "presentation_claim_ids": {"type": "array", "uniqueItems": true, "maxItems": 29, "items": {"type": "string", "minLength": 1}},
    "generation_status": {"enum": ["generated", "cached", "disabled", "unavailable", "rejected", "busy", "not_applicable"]},
    "generated_answer": {"type": ["string", "null"], "minLength": 1, "maxLength": 2400},
    "generated_claim_ids": {"type": "array", "uniqueItems": true, "maxItems": 5, "items": {"type": "string", "minLength": 1}},
    "clarification_choices": {"type": "array", "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["label", "question"], "properties": {"label": {"type": "string", "minLength": 1, "maxLength": 100}, "question": {"type": "string", "minLength": 1, "maxLength": 500}}}}
  },
  "allOf": [
    {"if": {"required": ["presentation_claim_ids"]}, "then": {"required": ["conversational_answer"], "properties": {"conversational_answer": {"type": "string"}}}},
    {"if": {"required": ["presentation_claim_ids"], "properties": {"status": {"const": "supported"}}}, "then": {"properties": {"presentation_claim_ids": {"minItems": 1}}}, "else": {"properties": {"presentation_claim_ids": {"maxItems": 0}}}},
    {"if": {"required": ["context_question"], "properties": {"context_question": {"type": "string"}}}, "then": {"properties": {"status": {"const": "supported"}, "evidence_packet": {"properties": {"status": {"const": "supported"}}}}}},
    {"if": {"properties": {"llm_status": {"const": "suggested"}}, "required": ["llm_status"]}, "then": {"required": ["suggested_question"], "properties": {"suggested_question": {"type": "string"}, "status": {"const": "insufficient_evidence"}}}},
    {"if": {"required": ["generation_status"]}, "then": {"required": ["generated_claim_ids"]}},
    {"if": {"required": ["generation_status"], "properties": {"generation_status": {"enum": ["generated", "cached"]}}}, "then": {"required": ["generated_answer", "generated_claim_ids"], "properties": {"status": {"const": "supported"}, "evidence_packet": {"properties": {"status": {"const": "supported"}}}, "generated_answer": {"type": "string"}, "generated_claim_ids": {"minItems": 1}}}, "else": {"properties": {"generated_answer": {"type": "null"}, "generated_claim_ids": {"maxItems": 0}}}}
  ]
}
