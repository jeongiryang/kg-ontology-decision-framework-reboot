{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jeongiryang/kg-ontology-decision-framework-reboot/contracts/source-entry.schema.json",
  "title": "SourceEntry",
  "description": "Identity, applicability, authority, and review state of an academic source without local paths or secrets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "title",
    "sha256",
    "effective_date",
    "academic_years",
    "departments",
    "authority",
    "review_state"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "source_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "title": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "effective_date": { "type": "string", "format": "date" },
    "supersedes_source_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "academic_years": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1900, "maximum": 2200 }
    },
    "departments": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "authority": {
      "type": "string",
      "enum": ["university_statute", "curriculum", "department_guidance", "validation_aid"]
    },
    "review_state": {
      "type": "string",
      "enum": ["pending", "approved", "rejected", "needs_review"]
    },
    "canonical_locator": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!(?:[A-Za-z]:[\\\\/]|/|\\\\\\\\|[Ff][Ii][Ll][Ee]:)).+",
      "description": "Public or repository-relative locator; Windows, Unix, UNC, and file URI absolute paths are prohibited."
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
